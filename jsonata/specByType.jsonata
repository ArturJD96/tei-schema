(

  /*
    Explicitly list supported tag's attributes
    (and their supported values)
  */
  $assertAttrSupport := function($el, $attrDict) {(

    $attrs := $el.attributes;
    $each($el.attributes, function($attrVal, $attrName) {(
      $attr := $lookup($attrDict, $attrName);
      $attr ?? $error('Unsupported argument "'&$attrName&'" for <'&$el.name&'>.');
      ($type($attr) = 'array') ? ($attrVal in $attr) ?: $error('Unsupported argument: <'&$el.name&' '&$attrName&'="'&$attrVal&'"> (supporting only ['&$join($attr, ',')&']).')
    )})

  )};

  $reportAttrUnimplemented := function($el, $attrDict) {(

    /* TO DO: print warning if attr is currently unsupported. */

    /* $warn('Following attributes of <'&$el.name&'> are not supported: '&$attrDict) */

  )};



  /* For JSON */

  $unhandled := function($el) { { '$ERROR_UNHANDLED': $el.name } };


  $handlersJSON := {

    '_template_': function($el) {(

      $assertAttrSupport($el, {});
      $reportAttrUnimplemented($el);
      $handleChildrenForJSON($el);

    )},

    'alternate': function($el) {(

      $assertAttrSupport($el, { 'minOccurs': 'number', 'maxOccurs': 'number' });
      $reportAttrUnimplemented($el, {'minOccurs': 'number',  'maxOccurs': 'number' } );
      $handleChildrenForJSON($el);

      {
        'oneOf': $map($el.elements[type='element'], $handleElemForJSON)
      }

    )},

    'anyElement': function($el) {(



    )},

    'attDef': function($el) {(

      $attrs := $el.attributes;
      $assertAttrSupport($el, {
        'ident': 'string',
        'usage': ['req', 'rec', 'opt'], /* Handled at attList. */
        'mode': ['add', 'change', 'delete', 'replace'],
        'module': 'string',
        /* Description */
        'validUntil': 'string'
      });

      $reportAttrUnimplemented($el, {
        'mode': ['add', 'change', 'delete', 'replace'],
        'module': 'string',
        /* Description */
        'validUntil': 'string'
      });

      $handleChildrenForJSON($el);

      {
        $attrs.ident: {
          'title': $attrs.ident,
          '$comment': ($attrs.usage = 'rec') ? "Recommended."
          /* TO DO: $el */
        }
      }

    )},

    'attRef': function($el) {(

      { 'test': $el.name }

    )},

    'classRef': function($el) {(

      $assertAttrSupport($el, { 'key': 'string', 'minOccurs': 'number', 'maxOccurs': 'number', 'expand': 'string' });
      $reportAttrUnimplemented($el, { 'minOccurs': 'number', 'maxOccurs': 'number', 'expand': 'string' });
      $handleChildrenForJSON($el);

      {
        '$ref': '#/$defs/' & $el.attributes.key
      }

    )},

    'dataRef': function($el) {(

      $assertAttrSupport($el, { 'key':'string', 'name': 'string', 'restriction': 'pattern' });
      $reportAttrUnimplemented($el, { 'key':'string', 'name': 'string', 'restriction': 'pattern'  });
      $handleChildrenForJSON($el);

    )},

    'datatype': function($el) {(

      $assertAttrSupport($el, { 'minOccurs': 'number', 'maxOccurs': 'number' });
      $reportAttrUnimplemented($el, { 'minOccurs': 'number', 'maxOccurs': 'number' });
      $handleChildrenForJSON($el);

    )},

    'defaultVal': function($el) {(

      $assertAttrSupport($el, {});
      $reportAttrUnimplemented($el);
      $handleChildrenForJSON($el);

    )},

    'elementRef': function($el) {(

      $assertAttrSupport($el, { 'key': 'string', 'minOccurs': 'number', 'maxOccurs': 'number'  });
      $reportAttrUnimplemented($el, { 'minOccurs': 'number', 'maxOccurs': 'number'  });
      $handleChildrenForJSON($el);

      {
        '$ref': '#/$defs/' & $el.attributes.key
      }

    )},

    'empty': function($el) {(

      $assertAttrSupport($el, {});
      $reportAttrUnimplemented($el, {});

      $handleChildrenForJSON($el);

    )},

    'macroRef': function($el) {(

      $assertAttrSupport($el, { 'key':'string' });
      $reportAttrUnimplemented($el, { 'key':'string' });

      $handleChildrenForJSON($el);

    )},

    'paramList': function($el) {(

      $assertAttrSupport($el, {});
      $reportAttrUnimplemented($el, {});

      $handleChildrenForJSON($el);

    )},

    'paramSpec': function($el) {(

      $assertAttrSupport($el, { 'ident': 'string' });
      $reportAttrUnimplemented($el, {});

      $handleChildrenForJSON($el);

    )},

    'sequence': function($el) {(

      $assertAttrSupport($el, { 'minOccurs': 'number', 'maxOccurs': 'number' });
      $reportAttrUnimplemented($el, { 'minOccurs': 'number', 'maxOccurs': 'number' });

      $handleChildrenForJSON($el);

    )},

    'textNode': function($el) {(

      $assertAttrSupport($el, {});
      $reportAttrUnimplemented($el);
      $handleChildrenForJSON($el);

    )},

    'valList': function($el) {(

      $assertAttrSupport($el, { 'type':['closed', 'semi', 'open'], 'xml:lang':'string' });
      $reportAttrUnimplemented($el, { type':['closed', 'semi', 'open'], 'xml:lang':'string' });

      $handleChildrenForJSON($el);

    )},

    'valDesc': function($el) {(

      $assertAttrSupport($el, { 'xml:lang':'string' });
      $reportAttrUnimplemented($el, { 'xml:lang':'string' });

      $handleChildrenForJSON($el);

    )},

    'valItem': function($el) {(

      $assertAttrSupport($el, { 'ident': 'string' });
      $reportAttrUnimplemented($el, { 'ident': 'string' });

      $handleChildrenForJSON($el);

    )},


    /*
     *  Top-level handlers
     */

    /*
        Turn <attList> into {properties}.
    */
    'attList': function($el) {(

      $attrs := $el.attributes;
      $required := $el.**[type='element' and name='attDef' and attributes.usage='req'].attributes.ident[];

      /*
        TO DO: org attribute support.
        I don't understand what it does...
      */
      $assertAttrSupport($el, { 'org': ['group', 'choice'] });
      $reportAttrUnimplemented($el, { 'org': ['group', 'choice'] });

      {
        'properties': $handleChildrenForJSON($el),
        'required': $required,
        'additionalProperties': false
      }

    )},

    'content': function($el) {(

      {
        'items': {

          'ch': $handleChildrenForJSON($el)

        }
      }

    )},

    'equiv': $unhandled,

    'constraintSpec': $unhandled,

    /*
        Turn <classes> to {allOf:anyOf} with references to classes.
    */
    'classes': function($el) {(

        $classTags := ['memberOf']; /* ONLY? How to derive it from the spec? */

        $memberOfs := $el.elements[type='element' and name='memberOf'];
        $attrs := $memberOfs.attributes;

        $memberOfs.elements[type='text'] ? $error('Unsupported <memberOf> with text content as reference: ' & $memberOfs.elements[type='text']);
        $assertAttrSupport($el, { 'mode': ['add','delete']});
        /* TO DO: support attrs 'min' and 'max'. */


        $addClasses := $attrs[(mode ?? 'add')='add'].key;
        $delClasses := $attrs[mode='delete'].key;
        $not($attrs.mode ?: 'add' in ['add', 'delete']) ? $error('Unsupported $memberOf mode: ' & $attr.mode);

        ($addClasses or $delClasses) ? {
            "allOf": [
                $addClasses ? { "anyOf": $addClasses.{ '$ref': '#/$defs/' & $ } },
                $delClasses ? { "not": { "anyOf": $delClasses.{ '$ref': '#/$defs/' & $ } } }
            ]
        }

    )},

    /*
        Spec classes.
    */

    'elementSpec': function($el) {(

      $assertAttrSupport($el, {

        'ns': 'string',
        'xmlns': 'string',
        'xmlns:sch': 'string',
        'xmlns:teix': 'string',
        'xmlns:xi': 'string',
        'xmlns:rng': 'string',
        'module': 'string',
        'xml:id': 'string',
        'ident': 'string',
        'mode': ['add'],
        'validUntil': 'string'

      });

      $reportAttrUnimplemented($el, {
        'ns': 'string',
        'xmlns': 'string',
        'xmlns:sch': 'string',
        'xmlns:teix': 'string',
        'xmlns:xi': 'string',
        'xmlns:rng': 'string',
        'module': 'string',
        'xml:id': 'string',

        'ident': 'string',
        'mode': 'string',
        'validUntil': 'string'
      });

      $handleChildrenForJSON($el)

    )},

    'classSpec': function($el) {(

      $assertAttrSupport($el, {

        'xml:id': 'string',
        'xmlns': 'string',
        'xmlns:sch': 'string',
        'xmlns:rng': 'string',

        'ident': 'string',
        'module': 'string',
        'type': 'string',
        'predeclare': 'string'

      });

      $reportAttrUnimplemented($el, {
        'xml:id': 'string',
        'xmlns': 'string',
        'xmlns:sch': 'string',
        'xmlns:rng': 'string',
        'ident': 'string',
        'module': 'string',
        'type': 'string',
        'predeclare': 'string'
      });

      $handleChildrenForJSON($el)

    )},

    'macroSpec': function($el) {(

      $assertAttrSupport($el, {

        'xml:id': 'string',
        'xmlns': 'string',
        'xmlns:rng': 'string',

        'ident': 'string',
        'module': 'string',
        'mode': 'string'

      });

      $reportAttrUnimplemented($el, {
        'xml:id': 'string',
        'xmlns': 'string',
        'xmlns:rng': 'string',
        'ident': 'string',
        'module': 'string',
        'mode': 'string'
      });

      $handleChildrenForJSON($el)

    )},

    'dataSpec': function($el) {(

      $assertAttrSupport($el, {

        'xml:id': 'string',
        'xmlns': 'string',

        'ident': 'string',
        'module': 'string'

      });

      $reportAttrUnimplemented($el, {
        'xml:id': 'string',
        'xmlns': 'string',
        'ident': 'string',
        'module': 'string'
      });

    )}

  };


  /*
    Hydrate tag with JSON Schema description
    and remove description elements.
  */
  $describe := function($el) {(

    /*
    $contains($el.name, \/.+Spec$\/) ?: $error('Unsupported spec element: ' & ($spec.name ?? $spec));
    */

    $descriptorTags := [
        'gloss',
        'desc',
        'remarks',
        'exemplum',
        'listRef'
    ];

    $description := {

        "title": "",
        "$comment": "",
        "description": "",
        "examples": [""],
        "deprecated": false

    };

    /*
    $gloss := $el.elements[name='gloss'].elements;
    $desc := $el.elements[name='desc'].elements;
    $remarks := $el.elements[name='remarks'].elements;
    $listRef := $el.elements[name='listRef'].elements;
    */

    $descriptors := $el.elements[name in $descriptorTags];
    /* TO DO: merge this description! */
    $el ~> | $ | { "elements": $.elements[$not(name in $descriptorTags)] ?: [] } |

  )};

  $handleChildrenForJSON := function($el) {(

    $children := $el.elements[type='element'];
    $handledChildren := $merge($map($children, $handleElemForJSON));

    $handledChildren

  )};

  /*
    Handle each child element.
  */
  $handleElemForJSON := function($el) {(

    $handle := function($el) {(
        $handler := $lookup($handlersJSON, $el.name);
        $handler ?? $error('Unhandled element: ' & ($el.name ? '<' & $el.name &'>' : $el));
        $handler($el)
    )};

    $elHandled := $el ~> $describe ~> $handle;

    /* Clean-up */
    $xmlTags := ['type', 'name', 'attributes', 'elements'];
    $elHandled ~> | $ | $, $xmlTags |

  )};

  /*
    Group tags definitions by spec type.
  */
  $specs := *.elements[type='element'];
  $specTypes := $specs.name ~> $distinct;
  /* $specDirectives := $specs.elements.name ~> $distinct; */

  $specsByType := $specTypes#$s.{
    $: $specs[name=$specTypes[$s]].{
      attributes.ident: $ ~> $handleElemForJSON
    } ~> $merge
  } ~> $merge;

  $specsByType;

  $specs.{
    attributes.ident: $ ~> $handleElemForJSON
  } ~> $merge;

)
